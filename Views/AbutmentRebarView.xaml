<Window x:Class="BIM.DatViet.Views.AbutmentRebarView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:BIM.DatViet.Views.Controls"
        xmlns:models="clr-namespace:BIM.DatViet.Models"
        Title="CÔNG CỤ RẢI THÉP MỐ CẦU THÔNG MINH"
        Width="1360" Height="820" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#F2F5F6"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="InkBrush" Color="#172A34"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#60717A"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#087D8C"/>
        <SolidColorBrush x:Key="AccentDarkBrush" Color="#075D69"/>
        <SolidColorBrush x:Key="LineBrush" Color="#D9E1E4"/>
        <SolidColorBrush x:Key="SoftBrush" Color="#F6F8F9"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#52646D"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="BaseButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="15,7"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#253A45"/>
            <Setter Property="BorderBrush" Value="#BFCBD1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.86"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#F3F6F7"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#D5DEE2"/>
                                <Setter TargetName="ButtonChrome" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="#9AA7AD"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Padding" Value="22,7"/>
        </Style>

        <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#52636D"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR HEADER -->
        <Border Background="#112D3A" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" Background="#087D8C" CornerRadius="8" Margin="0,0,14,0">
                        <TextBlock Text="ĐVB" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CÔNG CỤ RẢI THÉP MỐ CẦU TỰ ĐỘNG"
                                   Foreground="White" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="{Binding HeaderStatusText}" Margin="0,2,0,0"
                                   Foreground="#BFD8DE" FontSize="11"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding DesignReadinessText}" Foreground="#D8EEF1"
                                       FontSize="10" FontWeight="SemiBold"/>
                            <TextBlock Text="  •  " Foreground="#86AEB7" FontSize="10"/>
                            <TextBlock Text="{Binding RuntimeReadinessText}" Foreground="#D8EEF1"
                                       FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CompletionReadinessText}" Margin="0,2,0,0"
                                   Foreground="#FFD27A" FontSize="10" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding CompletionReadinessText}"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="Đóng" Style="{StaticResource QuietButtonStyle}"
                        Foreground="White" Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <!-- MAIN BODY CONTENT -->
        <Grid Grid.Row="1" Margin="18,14,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*" MinWidth="600"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="1.1*" MinWidth="440"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT 3D VIEWPORT -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="16,0" Background="#FAFCFC">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MÔ HÌNH 3D XEM TRƯỚC" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="{Binding SelectedModelTitle}" Margin="0,2,0,0"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        </StackPanel>
                        <ComboBox x:Name="ViewportReviewModeSelector"
                                  Grid.Column="1"
                                  ItemsSource="{Binding ViewportRenderModes}"
                                  SelectedItem="{Binding SelectedViewportRenderMode, Mode=TwoWay}"
                                  AutomationProperties.Name="Chế độ review viewport"
                                  ToolTip="Chỉ đổi cách hiển thị của viewport xem trước; không thay đổi view hoặc model Revit."
                                  VerticalAlignment="Center" MinHeight="32">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Border Grid.Row="1" Background="#18242B" ClipToBounds="True">
                        <Grid>
                            <controls:AbutmentZoneViewport3D x:Name="ZoneViewport"/>

                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="10" Padding="8,5" Background="#D9112D3A" CornerRadius="5"
                                    MaxWidth="390" IsHitTestVisible="False">
                                <TextBlock Text="Canonical zone từ hình học thực tế  •  Chuột trái: xoay  •  Chuột phải: dịch  •  Cuộn: thu phóng"
                                           Foreground="#EAF3F5" FontSize="10" TextAlignment="Right"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="#CED8DC"/>

            <!-- RIGHT CONFIGURATION PANEL -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <TextBlock Text="BẢNG THÔNG SỐ RẢI THÉP MỐ CẦU" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="Mark, đường kính, spacing và cover đang hiển thị giá trị preset; Create chỉ mở sau khi đủ phê duyệt. Người dùng chỉ chọn RebarBarType."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,12" TextWrapping="Wrap"/>

                        <!-- CANONICAL ZONE -->
                        <Border Background="#F4F7F8" BorderBrush="#E0E6E9" BorderThickness="1" 
                                CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="1. PHÂN TÍCH VÀ KHÓA KHU VỰC CANONICAL" Style="{StaticResource CaptionStyle}"/>
                                
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <Label x:Name="ZoneLabel" Content="Khu vực kết cấu" Foreground="#52646D"
                                               FontSize="11" FontWeight="SemiBold" Padding="0"
                                               Target="{Binding ElementName=ZoneSelector}"/>
                                        <ComboBox x:Name="ZoneSelector"
                                                  ItemsSource="{Binding AvailableZones}"
                                                  
                                                  SelectedItem="{Binding SelectedZoneOption, Mode=TwoWay}"
                                                  AutomationProperties.Name="Khu vực kết cấu"
                                                  Margin="0,4,0,0" MinHeight="42">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#60717A"
                                                                   MaxWidth="410" TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding StatusText}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="Phân tích hình học" 
                                            Command="{Binding AnalyzeCommand}"
                                            AutomationProperties.Name="Phân tích hình học mố cầu"
                                            Style="{StaticResource BaseButtonStyle}" Margin="0,18,0,0" MinHeight="42"/>
                                </Grid>
                                <Border Background="#EAF4F5" BorderBrush="#C7E0E3" BorderThickness="1"
                                        CornerRadius="5" Padding="9,7" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding PreviewNoticeText}" Foreground="#244C55"
                                               FontSize="11" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- REBAR LAYERS FOR SELECTED ZONE -->
                        <TextBlock Text="2. CÁC LỚP THÉP CỦA KHU VỰC ĐANG CHỌN" 
                                   Style="{StaticResource CaptionStyle}" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding LayerSummaryText}" Foreground="{StaticResource MutedBrush}"
                                   FontSize="10" Margin="0,0,0,7"/>

                        <ItemsControl ItemsSource="{Binding Layers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FAFCFC" BorderBrush="#E1E8EC" BorderThickness="1" 
                                            CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="24"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="85"/>
                                                <ColumnDefinition Width="70"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Toggle Enable -->
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                      IsEnabled="False"
                                                      AutomationProperties.Name="{Binding ToggleAutomationName}"
                                                      VerticalAlignment="Center" Margin="0,0,6,0"
                                                      ToolTip="Trạng thái lớp thép khóa theo preset; xem gate Thiết kế"/>

                                            <!-- Color Badge -->
                                            <Ellipse Grid.Column="1" Width="13" Height="13" 
                                                     Fill="{Binding LayerColor}" VerticalAlignment="Center"/>

                                            <!-- Layer Title & Info -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding MarkDisplayText}" FontWeight="Bold" Foreground="#112D3A"/>
                                                    <TextBlock Text=" • " Foreground="#90A4AE"/>
                                                    <TextBlock Text="{Binding PlannedQuantityText}" FontWeight="SemiBold" Foreground="#087D8C"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding LayerName}" FontSize="10" Foreground="#60717A" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="9" Foreground="#7A5B42"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
                                                <TextBlock Text="{Binding DesignBasisText}" FontSize="9" Foreground="#52636D"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DesignBasisText}"/>
                                            </StackPanel>

                                            <!-- Bar Type Selection -->
                                            <ComboBox Grid.Column="3" 
                                                      ItemsSource="{Binding DataContext.AvailableBarTypeNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding BarTypeName, Mode=TwoWay}"
                                                      IsEnabled="{Binding CanEdit}"
                                                      AutomationProperties.Name="{Binding BarTypeAutomationName}"
                                                      Margin="2,0" Height="28" FontSize="12"/>

                                            <!-- Explicit station count -->
                                            <TextBox Grid.Column="4"
                                                     Text="{Binding DistributionText, Mode=OneWay}"
                                                     IsReadOnly="True" IsTabStop="False"
                                                     AutomationProperties.Name="Số vị trí station theo hồ sơ"
                                                     ToolTip="Hiện 'vị trí khóa' chỉ khi đủ centerline offsets; 'matrix only' hoặc 'st chưa khóa' không được dùng để Create"
                                                     Margin="2,0" Padding="4,2" Height="28" FontSize="12"
                                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- COVER SETUP MOVED BELOW LAYER LIST -->
                        <Border Background="#F4F7F8" BorderBrush="#E0E6E9" BorderThickness="1"
                                CornerRadius="8" Padding="12" Margin="0,8,0,10">
                            <StackPanel>
                                <TextBlock Text="3. LỚP BẢO VỆ CỦA KHU VỰC" Style="{StaticResource CaptionStyle}"/>
                                <TextBlock Text="{Binding CoverStatusText}" FontSize="10" Foreground="#60717A"
                                           TextWrapping="Wrap" Margin="0,3,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Label Content="Mặt trên (mm)" Foreground="#52646D" FontSize="11"
                                               FontWeight="SemiBold" Padding="0" Target="{Binding ElementName=CoverTopInput}"/>
                                        <TextBox x:Name="CoverTopInput"
                                                 Text="{Binding CoverTopMm, Mode=OneWay}"
                                                 IsReadOnly="True" IsTabStop="False"
                                                 AutomationProperties.Name="Lớp bảo vệ preset mặt trên, milimét"
                                                 ToolTip="Cover khóa; Create chỉ mở khi có nguồn hoặc phê duyệt"
                                                 Margin="0,4,0,0" Padding="8,4" Height="30"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <Label Content="Mặt dưới (mm)" Foreground="#52646D" FontSize="11"
                                               FontWeight="SemiBold" Padding="0" Target="{Binding ElementName=CoverBottomInput}"/>
                                        <TextBox x:Name="CoverBottomInput"
                                                 Text="{Binding CoverBottomMm, Mode=OneWay}"
                                                 IsReadOnly="True" IsTabStop="False"
                                                 AutomationProperties.Name="Lớp bảo vệ preset mặt dưới, milimét"
                                                 ToolTip="Cover khóa; Create chỉ mở khi có nguồn hoặc phê duyệt"
                                                 Margin="0,4,0,0" Padding="8,4" Height="30"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ISSUES & ACTION GATE SUMMARY -->
                        <Border Background="#F9FAFA" BorderBrush="#E0E6E9" BorderThickness="1" 
                                CornerRadius="6" Padding="10" Margin="0,8,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding IssueSummaryText}" FontWeight="SemiBold" Foreground="#263238"/>
                                <TextBlock Text="{Binding ActionReadinessText}" FontSize="11" Foreground="#546E7A" Margin="0,3,0,0"/>
                                <ItemsControl ItemsSource="{Binding Issues}" Margin="0,5,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#4F6B7A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Severity, Mode=OneWay}"
                                                                         Value="{x:Static models:ValidationSeverity.Warning}">
                                                                <Setter Property="Foreground" Value="#8A6500"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity, Mode=OneWay}"
                                                                         Value="{x:Static models:ValidationSeverity.Error}">
                                                                <Setter Property="Foreground" Value="#A22A20"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding Code, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text=": "/>
                                                <Run Text="{Binding Message, Mode=OneWay}"/>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- BOTTOM ACTION BUTTONS -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding ActionReadinessText}" VerticalAlignment="Center"
                           Foreground="#425C67" TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Hoàn tác" Command="{Binding UndoCommand}" Style="{StaticResource BaseButtonStyle}"
                            ToolTipService.ShowOnDisabled="True" ToolTip="Hoàn tác lần chỉnh sửa thông số gần nhất"/>
                    <Button Content="Tạo thép mới" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButtonStyle}"
                            ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ActionReadinessText}"/>
                    <Button Content="Tạo lại khu vực" Command="{Binding RebuildCommand}" Style="{StaticResource BaseButtonStyle}"
                            ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ActionReadinessText}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
