<Project Sdk="Nice3point.Revit.Sdk/6.2.2">

    <PropertyGroup>
        <AssemblyName>BIM.DatViet</AssemblyName>
        <RootNamespace>BIM.DatViet</RootNamespace>
        <Product>BIM-DatViet</Product>
        <UseWPF>true</UseWPF>
        <!-- Offline-safe defaults. Controlled rollout must opt in explicitly on the command line. -->
        <DeployAddin>false</DeployAddin>
        <LaunchRevit>false</LaunchRevit>
        <!-- This project is a Revit-loaded class library. F5 starts the matching Revit host. -->
        <StartAction>Program</StartAction>
        <StartProgram>C:\Program Files\Autodesk\Revit $(RevitVersion)\Revit.exe</StartProgram>
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
        <IsRepackable>false</IsRepackable>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <Configurations>Debug.R23;Debug.R24;Debug.R25;Debug.R26;Debug.R27</Configurations>
        <Configurations>$(Configurations);Release.R23;Release.R24;Release.R25;Release.R26;Release.R27</Configurations>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RevitVersion)' == '2027'">
        <DefineConstants>$(DefineConstants);REVIT2027_OR_GREATER</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RevitVersion)' == '2026' Or '$(RevitVersion)' == '2027'">
        <DefineConstants>$(DefineConstants);REVIT2026_OR_GREATER</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <!-- Revit Dependencies -->
        <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />

        <!-- MVVM -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="System.Text.Json" Version="8.0.5" Condition="'$(RevitVersion)' != '2027'" />

        <!-- Development Dependencies -->
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" PrivateAssets="all" />
        <PackageReference Include="Polyfill" Version="10.5.1" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Resources\Icons\*.png" />
        <Content Include="Resources\Presets\*.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <Content Include="Resources\DVB_Abutment_SharedParameters.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
        <EmbeddedResource Include="Resources\Presets\*.json" LogicalName="BIM.DatViet.Resources.Presets.%(Filename)%(Extension)" />
        <EmbeddedResource Include="Resources\DVB_Abutment_SharedParameters.txt" LogicalName="BIM.DatViet.Resources.DVB_Abutment_SharedParameters.txt" />
    </ItemGroup>


    <ItemGroup>
        <Folder Include="Models" />
    </ItemGroup>

</Project>
